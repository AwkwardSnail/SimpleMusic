<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleMusic</RootNamespace>
    <AssemblyName>SimpleMusic</AssemblyName>
    <Product>Simple Music Melody</Product>
    <AssemblyTitle>Simple Music Melody</AssemblyTitle>
    <Company>aWkward Snail</Company>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Packaging\Assets\SimpleMusic.ico</ApplicationIcon>
    <!-- The app is English only; leave out .NET's translated messages so the
         Store doesn't list languages SimpleMusic doesn't support. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packaging scripts are tools, not part of the app. -->
    <Compile Remove="Packaging\**" />
    <Resource Include="Packaging\Assets\SimpleMusic.ico" />
    <Resource Include="Packaging\Assets\Square44x44Logo.scale-400.png" />
  </ItemGroup>

</Project>
